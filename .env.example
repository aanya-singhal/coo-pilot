# Copy to .env and fill in. Never commit .env.

# --- Supabase (backend) ---
# Project URL and service role key from Supabase -> Project Settings -> API.
# If these are left blank the backend runs with in-memory storage, which is
# handy for local frontend work but loses all data on restart.
SUPABASE_URL=
SUPABASE_KEY=

# Storage bucket for original uploaded documents.
SUPABASE_BUCKET=documents

# --- Extraction (Person 1's module, called by the backend pipeline) ---
GEMINI_API_KEY=

# --- API ---
# Comma-separated allowed origins for the dashboard. "*" allows any origin.
CORS_ORIGINS=*
